# Every one of these is OPTIONAL. With none set, the API starts and serves
# every route using the in-memory store and a labelled stand-in geocoder.

PORT=8787
HOST=127.0.0.1

# Mappls / MapmyIndia — primary map provider (apis.mappls.com)
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Ola Maps — fallback provider (maps.olakrutrim.com)
OLA_MAPS_API_KEY=

# Postgres + PostGIS. Absent => in-memory store.
DATABASE_URL=

# Browser origins permitted to call this API.
CORS_ORIGINS=http://localhost:5178

TOKEN_SECRET=
