# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# The app runs FULLY with none of these set. Every unset key falls back to a
# mock adapter. Nothing here is required to develop or demo.
#
# IMPORTANT: every VITE_* variable is inlined into the client bundle as PLAIN
# TEXT and is readable by anyone who opens devtools. Only put browser-safe,
# domain-restricted keys here. Never an SMS, payment, or admin key — those need
# a backend. See docs/PRD.md §16 Q8.

# Maps + reverse geocoding. Restrict by HTTP referrer to localhost:5178 and
# your domain, and enable only the specific APIs you use.
VITE_MAPS_API_KEY=

# Nearby hospitals / police / fire stations.
# Often the same key as above — leave blank to reuse VITE_MAPS_API_KEY.
VITE_PLACES_API_KEY=
